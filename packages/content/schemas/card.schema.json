{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verseclash.local/schemas/card.schema.json",
  "title": "Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "universe", "arc", "name", "tier", "stars", "stats", "abilities"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[a-z0-9]{2}$",
      "description": "character-arc, e.g. luffy-eb. Special cards end in -sp, e.g. emu-sp."
    },
    "universe": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "arc": { "type": "string", "pattern": "^[a-z0-9]{2}$" },
    "name": { "type": "string", "minLength": 1 },
    "form": { "type": "string" },
    "tier": { "enum": ["C", "B", "A", "S", "GOD"] },
    "stars": { "type": "integer", "minimum": 1, "maximum": 5 },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atk", "def", "sup", "heal", "lead"],
      "properties": {
        "atk":  { "type": "integer", "minimum": 0, "maximum": 100 },
        "def":  { "type": "integer", "minimum": 0, "maximum": 100 },
        "sup":  { "type": "integer", "minimum": 0, "maximum": 100 },
        "heal": { "type": "integer", "minimum": 0, "maximum": 100 },
        "lead": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "abilities": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "ability.schema.json#/$defs/id" }
    },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "image": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["arc", "quest", "wheel", "shop"] },
        "questId": { "type": "string" },
        "wheelId": { "type": "string" },
        "price": { "type": "integer", "minimum": 0 }
      }
    }
  }
}