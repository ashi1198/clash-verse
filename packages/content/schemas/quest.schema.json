{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verseclash.local/schemas/quest.schema.json",
  "title": "Quest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "unlocks", "conditions"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "unlocks": { "type": "string" },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "enum": ["winArc", "winWithTag", "winCount", "ownCard", "clearLeague"] },
          "arc": { "type": "string", "pattern": "^[a-z0-9]{2}$" },
          "tag": { "type": "string" },
          "cardId": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}